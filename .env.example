# Copy to .env and fill in what you have. Every key is optional; an engine
# whose key is missing is skipped and shown as "not measured", never as zero.

# ---- Answer engines (the assistants being measured) ----------------------
# ChatGPT, via the OpenAI Responses API with hosted web search.
OPENAI_API_KEY=
# AEO_OPENAI_MODEL=gpt-4.1

# Perplexity, via the Sonar API.
PERPLEXITY_API_KEY=
# AEO_PERPLEXITY_MODEL=sonar

# Gemini, with Google Search grounding. Either a Gemini Developer API key...
GEMINI_API_KEY=
# ...or Vertex AI with application-default credentials:
# GEMINI_AUTH_MODE=vertex
# VERTEX_PROJECT_ID=
# VERTEX_REGION=global
# AEO_GEMINI_MODEL=gemini-3.5-flash

# Claude, via the Messages API with hosted web search.
ANTHROPIC_API_KEY=
# AEO_ANTHROPIC_MODEL=claude-opus-5

# Only measure these engines (comma-separated). Unset = every configured engine.
# AEO_ENGINES=openai,perplexity,gemini

# ---- The judge --------------------------------------------------------------
# One model reads every answer and reports how each brand was treated, and one
# writes the initial question panel from the company's website. Uses Anthropic
# when ANTHROPIC_API_KEY is set, otherwise Gemini. Force one with:
# AEO_JUDGE_PROVIDER=anthropic|gemini
# AEO_JUDGE_MODEL=claude-opus-5
# AEO_PANEL_MODEL=claude-opus-5
# Set to false to skip the judge pass: no competitor rows, no leaderboard.
# AEO_LLM_SCORING=true

# Optional. Better page text for question generation on JS-heavy sites.
FIRECRAWL_API_KEY=

# ---- Running it -------------------------------------------------------------
# PORT=3400
# Protects the whole app with HTTP basic auth (any username). Set this before
# exposing the app to the internet: every click here spends money.
ADMIN_PASSWORD=
# Where the SQLite database lives. Default: ./data
# AEO_DATA_DIR=./data

# Automatic readings on each company's cadence. Default on.
# AEO_SCHEDULER_ENABLED=true
# AEO_DISPATCH_INTERVAL_MS=900000
# AEO_COMPANY_CADENCE_HOURS=240
# AEO_CONCURRENCY=4
